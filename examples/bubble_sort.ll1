// Bubble sort of 20 random numbers using arrays

fn int main() {
    int arr[20];
    int i = 0;
    int temp = 0;
    int swapped = 1;

    // Initialize array with 20 values
    arr[0] = 328;
    arr[1] = 58;
    arr[2] = 13;
    arr[3] = 380;
    arr[4] = 141;
    arr[5] = 126;
    arr[6] = 115;
    arr[7] = 72;
    arr[8] = 378;
    arr[9] = 53;
    arr[10] = 347;
    arr[11] = 380;
    arr[12] = 457;
    arr[13] = 280;
    arr[14] = 45;
    arr[15] = 303;
    arr[16] = 217;
    arr[17] = 17;
    arr[18] = 16;
    arr[19] = 48;

    // Bubble sort
    while (swapped != 0) {
        swapped = 0;
        i = 0;
        while (i < 19) {
            if (arr[i] > arr[i + 1]) {
                temp = arr[i];
                arr[i] = arr[i + 1];
                arr[i + 1] = temp;
                swapped = 1;
            }
            i = i + 1;
        }
    }

    // Print sorted array
    i = 0;
    while (i < 20) {
        print(arr[i]);
        i = i + 1;
    }

    return arr[0];
}

// Bubble sort of 8 numbers using arrays in LL1

fn int main() {
    int arr[8];
    int i = 0;
    int j = 0;
    int temp = 0;

    // Initialize array with 8 values
    arr[0] = 328;
    arr[1] = 58;
    arr[2] = 13;
    arr[3] = 380;
    arr[4] = 141;
    arr[5] = 126;
    arr[6] = 115;
    arr[7] = 72;

    // Bubble sort: outer loop
    i = 0;
    while (i < 8) {
        j = i;
        while (j < 8) {
            if (arr[i] > arr[j]) {
                temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    // Print sorted array
    i = 0;
    while (i < 8) {
        print(arr[i]);
        i = i + 1;
    }

    return arr[0];
}

// Bubble sort of 20 numbers using arrays in LL1

fn int main() {
    int arr[20];
    int i = 0;
    int j = 0;
    int temp = 0;

    // Initialize array with 20 values
    arr[0] = 328;
    arr[1] = 58;
    arr[2] = 13;
    arr[3] = 380;
    arr[4] = 141;
    arr[5] = 126;
    arr[6] = 115;
    arr[7] = 72;
    arr[8] = 378;
    arr[9] = 53;
    arr[10] = 347;
    arr[11] = 380;
    arr[12] = 457;
    arr[13] = 280;
    arr[14] = 45;
    arr[15] = 303;
    arr[16] = 217;
    arr[17] = 17;
    arr[18] = 16;
    arr[19] = 48;

    // Bubble sort: outer loop
    i = 0;
    while (i < 20) {
        j = i;
        while (j < 20) {
            if (arr[i] > arr[j]) {
                temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    // Print sorted array
    i = 0;
    while (i < 20) {
        print(arr[i]);
        i = i + 1;
    }

    return arr[0];
}
